{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "lint": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/eslint.config.js",
                "$TURBO_ROOT$/tsconfig.json"
            ],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"]
        },
        "generate": {
            "dependsOn": ["^build", "build"],
            "outputs": []
        },
        "api:report": {
            "dependsOn": ["^build", "build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "dist/**",
                "tsconfig.tsbuildinfo",
                "api-extractor.json",
                "api-extractor-tsconfig.json",
                "$TURBO_ROOT$/config/api-extractor.common.json"
            ],
            "outputs": []
        },
        "api:check": {
            "dependsOn": ["^build", "build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "dist/**",
                "tsconfig.tsbuildinfo",
                "api-extractor.json",
                "api-extractor-tsconfig.json",
                "$TURBO_ROOT$/config/api-extractor.common.json",
                "$TURBO_ROOT$/etc/**"
            ],
            "outputs": []
        },
        "@node-jhora/core#build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "scripts/write-build-constants.mjs", "package.json"],
            "outputs": ["dist/**", "tsconfig.tsbuildinfo", "src/generated/**"]
        },
        "@node-jhora/format#build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/core/dist/**"],
            "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
        },
        "@node-jhora/ephe#build": {
            "outputs": []
        },
        "@node-jhora/ephe-long#build": {
            "outputs": []
        },
        "@node-jhora/ephe#test": {
            "dependsOn": ["@node-jhora/core#build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/**"],
            "outputs": ["coverage/**"]
        },
        "@node-jhora/analytics#api:report": {
            "outputs": ["../../etc/analytics.api.md"]
        },
        "@node-jhora/api#api:report": {
            "outputs": ["../../etc/api.api.md"]
        },
        "@node-jhora/core#api:report": {
            "outputs": ["../../etc/core.api.md"]
        },
        "@node-jhora/engine#api:report": {
            "outputs": ["../../etc/engine.api.md"]
        },
        "@node-jhora/ephe#api:report": {
            "dependsOn": ["build"],
            "outputs": ["../../etc/ephe.api.md"]
        },
        "@node-jhora/events#api:report": {
            "outputs": ["../../etc/events.api.md"]
        },
        "@node-jhora/format#api:report": {
            "outputs": ["../../etc/format.api.md"]
        },
        "@node-jhora/match#api:report": {
            "outputs": ["../../etc/match.api.md"]
        },
        "@node-jhora/prediction#api:report": {
            "outputs": ["../../etc/prediction.api.md"]
        },
        "@node-jhora/reporting#api:report": {
            "outputs": ["../../etc/reporting.api.md"]
        },
        "@node-jhora/testkit#generate": {
            "dependsOn": ["^build", "build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/packages/core/tests/fixtures/horizons_golden.ts",
                "$TURBO_ROOT$/packages/core/tests/fixtures/jhora_golden.ts"
            ],
            "outputs": [
                "schema/**",
                "../core/tests/fixtures/horizons.golden.json",
                "../core/tests/fixtures/jhora.golden.json"
            ]
        },
        "@node-jhora/core#test": {
            "dependsOn": ["^build", "build"],
            "outputs": ["coverage/**"]
        },
        "@node-jhora/atlas#api:report": {
            "outputs": ["../../etc/atlas.api.md"]
        }
    }
}
