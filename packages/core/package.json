{
    "name": "@node-jhora/core",
    "version": "3.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./browser": "./dist/browser/index.js",
        "./node/register": {
            "types": "./node/register.d.ts",
            "import": "./node/register.mjs"
        },
        "./node/ephemeris": {
            "types": "./node/ephemeris.d.ts",
            "import": "./node/ephemeris.mjs"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "node-jhora-ephe": "./node/cli.mjs"
    },
    "license": "LicenseRef-NodeJHora-Source-Available",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "!dist/**/*.tsbuildinfo",
        "node",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "api:report": "api-extractor run --local",
        "api:check": "api-extractor run",
        "build": "node scripts/write-build-constants.mjs && tsc",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint .",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.js"
    },
    "dependencies": {
        "decimal.js": "^10.4.3",
        "luxon": "^3.7.2",
        "zod": "4.6.7"
    },
    "peerDependencies": {
        "@node-jhora/ephe": "workspace:^"
    },
    "peerDependenciesMeta": {
        "@node-jhora/ephe": {
            "optional": true
        }
    },
    "devDependencies": {
        "@node-jhora/testkit": "workspace:*",
        "@types/jest": "^30.0.0",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "@node-jhora/ephe": "workspace:*",
        "typescript": "^5.9.3"
    },
    "keywords": [
        "vedic-astrology",
        "jyotish",
        "jpl-de440",
        "panchanga",
        "horoscope",
        "vargas",
        "kundli",
        "ayanamsa",
        "astronomy"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HariEshwar-J-A/node-jhora.git",
        "directory": "packages/core"
    }
}
