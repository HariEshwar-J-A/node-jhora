{
    "name": "@node-jhora/events",
    "version": "3.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "license": "LicenseRef-NodeJHora-Source-Available",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "!dist/**/*.tsbuildinfo",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "api:report": "api-extractor run --local",
        "api:check": "api-extractor run",
        "build": "tsc",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint .",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.js"
    },
    "dependencies": {
        "@node-jhora/core": "workspace:*",
        "luxon": "^3.7.2"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    },
    "keywords": [
        "astronomy",
        "event-detection",
        "transit-scanner",
        "planet-ingress",
        "retrograde-station",
        "ephemeris-events"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HariEshwar-J-A/node-jhora.git",
        "directory": "packages/events"
    }
}
