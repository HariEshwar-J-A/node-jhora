{
    "name": "@node-jhora/ephe",
    "version": "440.2.0",
    "description": "JPL DE440s ephemeris data for node-jhora (public domain, NASA/JPL)",
    "type": "module",
    "license": "SEE LICENSE IN LICENSE",
    "main": "index.mjs",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        },
        "./constants.mjs": {
            "types": "./constants.d.ts",
            "import": "./constants.mjs"
        },
        "./de440s.bsp": "./de440s.bsp",
        "./package.json": "./package.json"
    },
    "scripts": {
        "api:report": "api-extractor run --local",
        "api:check": "api-extractor run",
        "build": "node -e \"process.exit(0)\"",
        "typecheck": "node -e \"process.exit(0)\"",
        "lint": "eslint .",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../tools/jest.config.js && node --test ../../tools/check-forbidden-assets.test.mjs ../../tools/check-runtime-licenses.test.mjs",
        "fetch": "node download.mjs",
        "prepack": "node download.mjs"
    },
    "files": [
        "index.mjs",
        "index.d.ts",
        "constants.mjs",
        "constants.d.ts",
        "de440s.bsp",
        "NOTICE.md",
        "README.md"
    ],
    "keywords": [
        "jpl",
        "de440",
        "ephemeris",
        "astronomy",
        "vedic-astrology"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HariEshwar-J-A/node-jhora.git",
        "directory": "packages/ephe"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "author": {
        "name": "Harieshwar Jagan Abirami",
        "email": "harieshwar.dev@gmail.com",
        "url": "https://harieshwar.dev"
    },
    "bugs": {
        "url": "https://github.com/HariEshwar-J-A/node-jhora/issues",
        "email": "harieshwar.dev@gmail.com"
    },
    "homepage": "https://github.com/HariEshwar-J-A/node-jhora#readme"
}
