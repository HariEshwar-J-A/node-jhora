{
    "name": "@node-jhora/engine",
    "version": "3.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./browser": "./dist/browser/index.js",
        "./browser/worker-entry": "./dist/browser/worker-entry.js",
        "./browser/worker-api": "./dist/browser/worker-api.js",
        "./package.json": "./package.json"
    },
    "license": "LicenseRef-NodeJHora-Source-Available",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "!dist/**/*.tsbuildinfo",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "api:report": "api-extractor run --local",
        "api:check": "api-extractor run",
        "build": "tsc",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint .",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.js"
    },
    "dependencies": {
        "@node-jhora/analytics": "workspace:*",
        "@node-jhora/core": "workspace:*",
        "@node-jhora/prediction": "workspace:*",
        "comlink": "^4.4.2",
        "luxon": "^3.7.2"
    },
    "devDependencies": {
        "@node-jhora/testkit": "workspace:*",
        "@types/jest": "^30.0.0",
        "@types/luxon": "^3.7.1",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.9.3"
    },
    "keywords": [
        "vedic-astrology",
        "jyotish",
        "chart-session",
        "astrology-engine"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HariEshwar-J-A/node-jhora.git",
        "directory": "packages/engine"
    }
}
