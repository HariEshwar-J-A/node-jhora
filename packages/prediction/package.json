{
    "name": "@node-jhora/prediction",
    "version": "3.1.1",
    "description": "Vimshottari, Yogini, Narayana and Chara dashas, transit scanning and Jaimini tools for node-jhora.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "!dist/**/*.tsbuildinfo",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "api:report": "api-extractor run --local",
        "api:check": "api-extractor run",
        "build": "tsc",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint .",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.js"
    },
    "dependencies": {
        "@node-jhora/core": "workspace:*",
        "@node-jhora/analytics": "workspace:*",
        "decimal.js": "^10.4.3",
        "luxon": "^3.7.2"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    },
    "keywords": [
        "vedic-astrology",
        "dasha",
        "vimshottari",
        "yogini",
        "jaimini",
        "chara-dasha",
        "transits",
        "gochara",
        "astrology-timing"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HariEshwar-J-A/node-jhora.git",
        "directory": "packages/prediction"
    },
    "author": {
        "name": "Harieshwar Jagan Abirami",
        "email": "harieshwar.dev@gmail.com",
        "url": "https://harieshwar.dev"
    },
    "bugs": {
        "url": "https://github.com/HariEshwar-J-A/node-jhora/issues",
        "email": "harieshwar.dev@gmail.com"
    },
    "homepage": "https://github.com/HariEshwar-J-A/node-jhora#readme"
}
