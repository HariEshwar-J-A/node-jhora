{
    "name": "@node-jhora/bench",
    "version": "3.1.0",
    "private": true,
    "type": "module",
    "description": "Performance budgets and regression gates for ChartSession and ephemeris init.",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint .",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.js",
        "bench": "node dist/run-bench.js",
        "bench:check": "node dist/check-baseline.js",
        "bench:workers": "node dist/bench-workers.js"
    },
    "dependencies": {
        "@node-jhora/core": "workspace:*",
        "@node-jhora/engine": "workspace:*",
        "luxon": "^3.7.2",
        "tinybench": "^4.0.1"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/luxon": "^3.7.1",
        "@types/node": "^25.0.3",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.9.3"
    },
    "license": "LicenseRef-NodeJHora-Source-Available",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HariEshwar-J-A/node-jhora.git",
        "directory": "packages/bench"
    }
}
