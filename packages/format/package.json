{
    "name": "@node-jhora/format",
    "version": "3.1.0",
    "type": "module",
    "description": "Versioned .njh JSON chart file schema, migrations, and lossless serialization.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./jhd": {
            "types": "./dist/jhd/index.d.ts",
            "import": "./dist/jhd/index.js"
        },
        "./node": {
            "types": "./dist/node/index.d.ts",
            "import": "./dist/node/index.js"
        },
        "./schema/njh-chart.schema.json": "./schema/njh-chart.schema.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "!dist/**/*.tsbuildinfo",
        "schema",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "api:report": "api-extractor run --local && node ../../tools/normalize-format-api-report.mjs",
        "api:check": "api-extractor run --local && node ../../tools/normalize-format-api-report.mjs && node ../../tools/normalize-format-api-report.mjs --check",
        "build": "tsc",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint .",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.js",
        "generate": "node ../../tools/run-jest-write-goldens.mjs --config jest.config.js tests/schema.test.ts"
    },
    "dependencies": {
        "@node-jhora/core": "workspace:*",
        "luxon": "^3.7.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/luxon": "^3.7.1",
        "@types/node": "^25.0.3",
        "fast-check": "^4.3.0",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.9.3"
    },
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HariEshwar-J-A/node-jhora.git",
        "directory": "packages/format"
    },
    "author": {
        "name": "Harieshwar Jagan Abirami",
        "email": "harieshwar.dev@gmail.com",
        "url": "https://harieshwar.dev"
    },
    "bugs": {
        "url": "https://github.com/HariEshwar-J-A/node-jhora/issues",
        "email": "harieshwar.dev@gmail.com"
    },
    "homepage": "https://github.com/HariEshwar-J-A/node-jhora#readme"
}
