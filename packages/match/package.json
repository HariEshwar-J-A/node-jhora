{
    "name": "@node-jhora/match",
    "version": "3.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "!dist/**/*.tsbuildinfo",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "api:report": "api-extractor run --local",
        "api:check": "api-extractor run",
        "build": "tsc",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint .",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.js"
    },
    "dependencies": {
        "@node-jhora/core": "workspace:*",
        "luxon": "^3.7.2"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.0.3"
    },
    "keywords": [
        "vedic-astrology",
        "matchmaking",
        "porutham",
        "ashta-kuta",
        "mangal-dosha",
        "gun-milan",
        "synastry",
        "horoscope-matching"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HariEshwar-J-A/node-jhora.git",
        "directory": "packages/match"
    }
}
