{
    "name": "node-jhora-monorepo",
    "version": "3.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build --filter=./packages/*",
        "typecheck": "turbo run typecheck --filter=./packages/*",
        "lint": "turbo run lint --filter=./packages/*",
        "test": "turbo run test --filter=./packages/*",
        "test:golden": "node scripts/run-golden-tests.mjs",
        "test:tools": "node --test tools/check-forbidden-assets.test.mjs tools/check-data-provenance.test.mjs tools/check-runtime-licenses.test.mjs tools/check-api-report-determinism.test.mjs && node tools/check-data-provenance.mjs && node --experimental-vm-modules node_modules/jest/bin/jest.js --config tools/jest.config.js tools/oracles/horizons.test.ts tools/horizons-oracle/compare.test.ts",
        "generate": "turbo run generate --filter=./packages/*",
        "api:report": "turbo run build --filter=./packages/* --filter=!./packages/testkit && turbo run api:report --filter=./packages/* --filter=!./packages/testkit",
        "api:check": "turbo run build --filter=./packages/* --filter=!./packages/testkit && turbo run api:check --filter=./packages/* --filter=!./packages/testkit",
        "check:clean-room": "node tools/check-forbidden-assets.mjs",
        "check:provenance": "node tools/check-data-provenance.mjs",
        "horizons:refresh": "pnpm exec tsx tools/oracles/horizons.ts",
        "horizons-oracle:refresh": "pnpm exec tsx tools/horizons-oracle/cli.ts refresh --live",
        "horizons-oracle:compare": "pnpm exec tsx tools/horizons-oracle/cli.ts compare",
        "horizons-oracle:nightly": "pnpm horizons-oracle:refresh && pnpm horizons-oracle:compare",
        "check:links": "node tools/check-markdown-links.mjs",
        "check:determinism": "node scripts/check-determinism.mjs",
        "check:licenses": "node tools/check-runtime-licenses.mjs",
        "check:browser-bundle": "node scripts/check-browser-bundle-size.mjs && node scripts/check-core-subpath-bundles.mjs",
        "test:browser": "pnpm --filter @node-jhora/browser-harness test:browser",
        "validate-github-templates": "node scripts/validate-github-templates.mjs",
        "docs:dev": "pnpm --filter @node-jhora/docs dev",
        "docs:build": "pnpm --filter @node-jhora/docs build",
        "postinstall": "node packages/ephe/download.mjs",
        "format:check": "prettier --check .",
        "bench": "pnpm --filter @node-jhora/bench run bench",
        "bench:check": "pnpm --filter @node-jhora/bench run bench:check",
        "changeset": "changeset",
        "check:pack": "node scripts/check-pack.mjs"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^9.39.1",
        "@microsoft/api-extractor": "^7.59.4",
        "@node-jhora/ephe": "workspace:*",
        "@types/jest": "^30.0.0",
        "@types/luxon": "^3.7.1",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^17.13.0",
        "jest": "^30.2.0",
        "js-yaml": "^3.15.2",
        "prettier": "^3.6.2",
        "publint": "^0.3.25",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.4",
        "turbo": "^2.11.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2",
        "esbuild": "^0.25.12"
    },
    "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
